{
  "$id": "export_verify.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "_meta": {
      "$ref": "_meta.schema.json"
    },
    "command": {
      "const": "export-verify"
    },
    "current": {
      "additionalProperties": true,
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "intact",
              "modified",
              "missing"
            ]
          }
        },
        "required": [
          "path",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "integrity": {
      "enum": [
        "intact",
        "mismatch"
      ]
    },
    "manifest_path": {
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": true,
      "type": "object"
    },
    "stale": {
      "type": "boolean"
    },
    "verification_policy": {
      "const": "local_export_receipt.v1"
    }
  },
  "required": [
    "_meta",
    "command",
    "manifest_path",
    "source",
    "current",
    "stale",
    "integrity",
    "files"
  ],
  "title": "export-verify --json output",
  "type": "object",
  "x-command": "export-verify"
}

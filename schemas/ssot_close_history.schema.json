{
  "$id": "ssot_close_history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "_meta": {
      "$ref": "_meta.schema.json"
    },
    "periods": {
      "additionalProperties": true,
      "type": "object"
    },
    "revisions": {
      "items": {
        "additionalProperties": true,

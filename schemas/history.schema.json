{
  "$id": "history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "_meta": {
      "$ref": "_meta.schema.json"
    },
    "count": {
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "archived": {
            "type": [
              "boolean",
              "string",
              "null"
            ]
          },
          "archived_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "field_issues": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "import_counts": {
            "additionalProperties": true,
            "type": "object"
          },
          "imported_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "imported_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "legacy_file_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "occurrence_id": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "original_filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_id": {
            "type": "string"
          },
          "source_artifact_preserved": {
            "type": "boolean"
          },
          "source_cells": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "source_fields": {
            "additionalProperties": true,
            "type": "object"
          },
          "source_row": {
            "type": "integer"
          },
          "source_rows": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "file_id",
          "imported_at"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "additionalProperties": true,
      "properties": {
        "archived_files": {
          "type": "integer"
        },
        "known_source_rows": {
          "type": "integer"
        },
        "unknown_archive_records": {
          "type": "integer"
        },
        "unknown_source_rows_records": {
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "_meta",
    "records",
    "count"
  ],
  "title": "history --json output",
  "type": "object"
}
